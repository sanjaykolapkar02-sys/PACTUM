# CommitmentPool Frontend - Environment Configuration
# Copy this file to .env and set your Privy App ID.
# NEVER place PRIVY_APP_SECRET in frontend code!

# 🔑 Privy App ID (Public - from https://dashboard.privy.io)
VITE_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# 🌐 Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# ⛓️ Monad Testnet Configuration
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_CHAIN_ID=10143

# 📜 Smart Contract Addresses (Monad Testnet - Chain ID 10143)
# To be provided after deployment:
# VITE_COMMITMENT_POOL_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

