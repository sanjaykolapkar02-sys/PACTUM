# CommitmentPool Backend - Environment Variables Example
# Copy this file to .env and fill in all values.
# NEVER commit .env to Git or expose credentials.

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5174

# 🍃 MongoDB Connection 🍃
# Use MongoDB Atlas URI or local MongoDB instance:
# e.g., mongodb+srv://<username>:<password>@<cluster>.mongodb.net/commitmentpool?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/commitmentpool

# 🔑 Privy Credentials (REQUIRED) 🔑
# Obtain from Privy Dashboard: https://dashboard.privy.io -> Settings -> API Keys
PRIVY_APP_ID=replace_with_actual_app_id
PRIVY_APP_SECRET=replace_with_actual_server_secret

# ⛓️ Monad Testnet ⛓️
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# 📜 Smart Contract Addresses (Monad Testnet - Chain ID 10143)
# To be provided after deployment:
# COMMITMENT_POOL_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

