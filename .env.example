# Frontend environment reference (all values are embedded in HTML directly
# as window.CP_CONFIG for vanilla HTML/JS — this file is for documentation only)
#
# Set these values in login.html, dashboard.html, faucet.html, and all other
# HTML pages that include the CP_CONFIG block:
#
#   window.CP_CONFIG = {
#     privyAppId: 'YOUR_PRIVY_APP_ID',  ← replace with value from dashboard.privy.io
#     backendUrl: 'http://localhost:3001'
#   };
#
# Backend variables live in backend/.env (see backend/.env.example)
