# Copy to .env and fill locally. NEVER commit .env or private keys.
RPC_URL=https://testnet-rpc.monad.xyz
EXPECTED_CHAIN_ID=10143
PRIVATE_KEY=0xREPLACE_WITH_TESTNET_ONLY_DEPLOYER_KEY
REVIEWER_ADDRESS=0xREPLACE_WITH_TRUSTED_TESTNET_REVIEWER_WALLET
TREASURY_ADDRESS=0xREPLACE_WITH_TESTNET_FEE_WALLET

# For script/CreatePool.s.sol (fill after factory deployment):
FACTORY_ADDRESS=0xREPLACE_WITH_FACTORY_ADDRESS
MEMBER_COUNT=2
MEMBER_1=0xREPLACE_WITH_DEPLOYER_WALLET
MEMBER_2=0xREPLACE_WITH_SECOND_FRIEND_WALLET
STAKE_USD=10
JOIN_DELAY_SECONDS=1800
PROOF_DURATION_SECONDS=86400
REQUIRED_APPROVALS=1
# bytes32 hash of canonical habit metadata JSON or content, not the actual photo.
METADATA_HASH=0xREPLACE_WITH_64_HEX_DIGITS
