# PACTUM (CommitmentPool) — .gitignore

# Environment & Secrets — NEVER commit
.env
.env.*
!.env.example
*.env
backend/.env*
!backend/.env.example
frontend/.env*
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds & Caches
dist/
dist-ssr/
frontend/dist/
backend/dist/
coverage/
.turbo/
.cache/

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

